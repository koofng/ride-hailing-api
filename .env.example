# Copy to .env and adjust. `docker compose` and `npm run start:dev` both read it.
NODE_ENV=development
PORT=3000

# Host-side port (5433, so it doesn't clash with other local Postgres instances).
# Inside docker compose, DB_HOST=db and DB_PORT=5432 are set automatically.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ride_hailing
DB_PASSWORD=ride_hailing
DB_NAME=ride_hailing

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=86400

BCRYPT_ROUNDS=12

# Where uploaded files are stored.
UPLOAD_DIR=uploads

# Base URL used to build photo links. Defaults to http://localhost:<PORT>, so
# leave it unset locally. Set it when clients reach the API at another address,
# e.g. PUBLIC_BASE_URL=https://api.example.com
# PUBLIC_BASE_URL=

# How long a signed profile photo link stays valid (links last between 1x and 2x this).
FILE_URL_TTL_SECONDS=900

# How long a trip request stays open for Drivers. After that, an unaccepted trip
# is cancelled with reason NO_DRIVER_FOUND.
TRIP_REQUEST_TTL_SECONDS=120
# How often expired requests are cancelled (0 turns the background check off).
TRIP_EXPIRY_SWEEP_SECONDS=10
