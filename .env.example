# Copy to .env and adjust. `docker compose` and `npm run start:dev` both read it.
NODE_ENV=development
PORT=3000

# Host-side port (5433, so it doesn't clash with other local Postgres instances).
# Inside docker compose, DB_HOST=db and DB_PORT=5432 are set automatically.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ride_hailing
DB_PASSWORD=ride_hailing
DB_NAME=ride_hailing

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=86400

BCRYPT_ROUNDS=12

# Where uploaded files are stored, and the base URL used to build photo URLs.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
